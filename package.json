{
  "name": "plain-english-options",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Say what you think a coin will do, in plain English, and get a defined-risk options spread on Derive.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project diff",
    "test:unit": "vitest run --project unit",
    "test:diff": "vitest run --project diff",
    "test:e2e": "playwright test",
    "test:live": "vitest run --project live",
    "record": "node --experimental-strip-types scripts/record-fixtures.ts",
    "check:mainnet": "node --experimental-strip-types --no-warnings scripts/check-mainnet.ts",
    "record:mainnet": "node --experimental-strip-types --no-warnings scripts/record-mainnet.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.14.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "ws": "^8.18.0"
  }
}
